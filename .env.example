# Copier ce fichier en .env et renseigner les valeurs (ne jamais commiter .env)
# Cle NASA (https://api.nasa.gov) : APOD, EPIC, images (section "En direct")
NASA_API_KEY=
# Jeton gratuit de l'API Systeme solaire OpenData (https://api.le-systeme-solaire.net/generatekey.html)
SSOD_TOKEN=
# Mot de passe de la page de moderation des avis (/avis/moderation/), 12 caracteres au moins, a choisir soi-meme
ADMIN_TOKEN=
