---
import '../styles/global.css';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Encyclopédie spatiale</title>
    <meta name="description" content="Encyclopédie spatiale interactive : planètes, exoplanètes, étoiles, galaxies, petits corps et missions, avec sources officielles." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#grid" data-i18n="skip">Aller au contenu</a>
    <header class="top">
      <div class="brand"><svg width="26" height="26" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="7" fill="#6ea8ff"/><ellipse cx="16" cy="16" rx="13" ry="4" fill="none" stroke="#e8eefc" stroke-width="1.6" transform="rotate(-20 16 16)"/></svg>
        <h1 data-i18n="title">Encyclopédie spatiale</h1></div>
      <div class="search"><label class="sr" for="q" data-i18n="search">Rechercher</label>
        <input id="q" type="search" autocomplete="off" data-i18n-ph="searchPh" placeholder="Rechercher un objet, un code (HD 209458, Kepler-452…)" /></div>
      <button id="lang" class="btn" type="button" aria-label="Language">EN</button>
    </header>

    <nav class="cats" id="cats" aria-label="Catégories"></nav>
    <div class="subs" id="subs" role="group" aria-label="Sous-catégories"></div>

    <main class="layout">
      <aside class="filters" id="filters" aria-label="Filtres">
        <button class="btn filt-toggle" id="filtToggle" type="button" aria-expanded="false" aria-controls="filtBody"><span data-i18n="filters">Filtres</span></button>
        <div id="filtBody" class="filt-body">
          <fieldset><legend data-i18n="f_mass">Masse (M⊕)</legend><div class="rng"><input id="f-m-min" type="number" min="0" step="any" aria-label="min" placeholder="min" /><span>–</span><input id="f-m-max" type="number" min="0" step="any" aria-label="max" placeholder="max" /></div></fieldset>
          <fieldset><legend data-i18n="f_radius">Rayon (R⊕)</legend><div class="rng"><input id="f-r-min" type="number" min="0" step="any" aria-label="min" placeholder="min" /><span>–</span><input id="f-r-max" type="number" min="0" step="any" aria-label="max" placeholder="max" /></div></fieldset>
          <fieldset><legend data-i18n="f_dist">Distance (années-lumière)</legend><div class="rng"><input id="f-d-min" type="number" min="0" step="any" aria-label="min" placeholder="min" /><span>–</span><input id="f-d-max" type="number" min="0" step="any" aria-label="max" placeholder="max" /></div></fieldset>
          <fieldset><legend data-i18n="f_temp">Température (K)</legend><div class="rng"><input id="f-q-min" type="number" min="0" step="any" aria-label="min" placeholder="min" /><span>–</span><input id="f-q-max" type="number" min="0" step="any" aria-label="max" placeholder="max" /></div></fieldset>
          <fieldset id="exoOnly"><legend data-i18n="f_exo">Exoplanètes</legend>
            <label class="lbl" for="f-type" data-i18n="f_type">Type</label><select id="f-type"></select>
            <label class="lbl" for="f-method" data-i18n="f_method">Méthode de découverte</label><select id="f-method"></select>
            <div class="rng"><input id="f-y-min" type="number" step="1" aria-label="année min" placeholder="année min" /><span>–</span><input id="f-y-max" type="number" step="1" aria-label="année max" placeholder="année max" /></div>
            <label class="chk"><input id="f-hz" type="checkbox" /> <span data-i18n="f_hz">Dans la zone habitable (calculée)</span></label>
          </fieldset>
          <label class="lbl" for="sort" data-i18n="sort">Tri</label><select id="sort"></select>
          <button class="btn" id="reset" type="button" data-i18n="reset">Réinitialiser</button>
        </div>
      </aside>

      <section aria-label="Résultats">
        <div id="simbadBox" class="simbad" hidden></div>
        <div id="live" class="live" hidden></div>
        <p id="count" class="count" role="status" aria-live="polite"></p>
        <ul id="grid" class="grid"></ul>
        <div id="sentinel" aria-hidden="true"></div>
      </section>
    </main>

    <dialog id="dlg" class="dlg" aria-labelledby="dlgTitle">
      <div class="dlg-in" id="dlgBody"></div>
    </dialog>

    <footer class="foot"><span id="foot"></span></footer>
    <script>import '../scripts/app.js';</script>
  </body>
</html>
