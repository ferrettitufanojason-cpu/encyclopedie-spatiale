---
import Doc from '../layouts/Doc.astro';
import FeedbackBox from '../components/FeedbackBox.astro';
---
<Doc titleFr="Avis et suggestions" titleEn="Feedback" description="Donnez votre avis sur l'Encyclopédie spatiale : une note de 1 à 5 étoiles, une idée, un problème ou une erreur à signaler." path="/avis/">
  <Fragment slot="fr">
    <p class="lead">Votre avis aide à améliorer le site : une note, une idée, un problème d'affichage, une erreur dans une donnée… Tout est lu.</p>
    <FeedbackBox l="fr" />
  </Fragment>
  <Fragment slot="en">
    <p class="lead">Your feedback helps improve the site: a rating, an idea, a display problem, an error in a value… Everything is read.</p>
    <FeedbackBox l="en" />
  </Fragment>
</Doc>
