---
// Balises communes : titre, description, adresse canonique, aperçu lors d'un partage (Open Graph / Twitter), icône.
interface Props { title: string; description: string; path?: string; noindex?: boolean }
const { title, description, path = Astro.url.pathname, noindex = false } = Astro.props;
const site = Astro.site ?? new URL('http://localhost:4322');
const url = new URL(path, site).href;
const img = new URL('/og.png', site).href;
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Encyclopédie spatiale" />
<meta property="og:locale" content="fr_FR" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={img} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Encyclopédie spatiale : planètes, étoiles, galaxies, missions, données officielles" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="theme-color" content="#0b1020" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{noindex && <meta name="robots" content="noindex" />}
