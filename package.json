{
  "name": "encyclopedie-spatiale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "import": "node scripts/import-all.mjs",
    "import:all": "node scripts/import-all.mjs",
    "import:solar": "node scripts/import-solar-system.mjs",
    "import:exoplanets": "node scripts/import-exoplanets.mjs",
    "import:simbad": "node scripts/import-simbad.mjs",
    "import:sbdb": "node scripts/import-sbdb.mjs",
    "import:missions": "node scripts/import-missions.mjs",
    "build:data": "node scripts/build-site-data.mjs",
    "dev": "npm run build:data && astro dev",
    "build": "npm run build:data && astro build",
    "build:all": "npm run import:all && npm run build",
    "preview": "node scripts/serve-local.mjs",
    "preview:static": "astro preview",
    "test": "node --test \"tests/*.test.mjs\"",
    "import:events": "node scripts/import-events.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "Encyclopédie spatiale interactive (Astro, site statique + fonctions serverless pour le direct)",
  "devDependencies": {
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "pdfjs-dist": "^4.10.38"
  }
}
